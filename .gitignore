# Build artefacts + secrets — never committed (keeps the every-turn sync clean)
__pycache__/
*.py[cod]
node_modules/
.venv/
.coverage
.coverage.*
build/
.svelte-kit/
.output/
.env
.env.*
!.env.example
/target/
# What a fuzz run writes beside its targets: the corpus it grows, crash artifacts, coverage data.
**/fuzz/corpus/
**/fuzz/artifacts/
**/fuzz/coverage/
