{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shimpz.com/assistant/v1/manifest.schema.json",
  "title": "Shimpz Assistant manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shimpz",
    "network"
  ],
  "properties": {
    "shimpz": {
      "$ref": "#/$defs/shimpz"
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "integrations": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/integration"
      }
    }
  },
  "$defs": {
    "shimpz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "id",
        "version",
        "name",
        "summary",
        "creators",
        "github",
        "genesis"
      ],
      "properties": {
        "spec": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/assistantIdentifier"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^@[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$"
          }
        },
        "github": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9])?$"
        },
        "genesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_hosts"
      ],
      "properties": {
        "allowed_hosts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        }
      }
    },
    "assistantIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "not": {
        "enum": [
          "postgres",
          "assistant-egress",
          "shimpz-assistant-egress"
        ]
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopes"
      ],
      "properties": {
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9.:/_-]*$"
          }
        }
      }
    }
  }
}
