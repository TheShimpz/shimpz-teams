{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shimpz.com/assistant/v1/result.schema.json",
  "title": "Shimpz Action response v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "result"],
      "properties": {
        "type": { "const": "result" },
        "result": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request"],
      "properties": {
        "type": { "const": "request" },
        "request": { "$ref": "#/$defs/humanRequest" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "stored_input"],
      "properties": {
        "type": { "const": "stored_input_rejected" },
        "stored_input": { "$ref": "#/$defs/identifier" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "failure"],
      "properties": {
        "type": { "const": "failure" },
        "failure": { "$ref": "#/$defs/failure" }
      }
    }
  ],
  "$defs": {
    "diagnosticText": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]*$"
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_type", "message", "provider", "http_status", "response_excerpt", "redacted", "truncated"],
      "properties": {
        "error_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "message": { "$ref": "#/$defs/diagnosticText" },
        "provider": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
            }
          ]
        },
        "http_status": {
          "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 100, "maximum": 599 }]
        },
        "response_excerpt": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/diagnosticText" }]
        },
        "redacted": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "copyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "params"],
      "properties": {
        "message": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "params": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 999999999999999
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?(?:\\.[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?)*$"
              }
            ]
          }
        }
      }
    },
    "optionalCopyReference": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/copyReference" }]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestBase": {
      "type": "object",
      "required": ["kind", "ordinal", "fingerprint", "title", "description"],
      "properties": {
        "kind": {},
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "title": { "$ref": "#/$defs/copyReference" },
        "description": { "$ref": "#/$defs/copyReference" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "description"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "label": { "$ref": "#/$defs/copyReference" },
        "description": { "$ref": "#/$defs/optionalCopyReference" }
      }
    },
    "inputBase": {
      "allOf": [
        { "$ref": "#/$defs/requestBase" },
        {
          "required": ["label", "required"],
          "properties": {
            "label": { "$ref": "#/$defs/copyReference" },
            "required": { "type": "boolean" }
          }
        }
      ]
    },
    "lengthInputBase": {
      "allOf": [
        { "$ref": "#/$defs/inputBase" },
        {
          "required": ["placeholder", "min_length", "max_length"],
          "properties": {
            "placeholder": { "$ref": "#/$defs/optionalCopyReference" },
            "min_length": {
              "type": "integer",
              "minimum": 0
            },
            "max_length": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "humanRequest": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "type": "object",
              "properties": { "kind": { "const": "approval" } }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "auth:password",
                    "auth:totp",
                    "auth:passkey"
                  ]
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/lengthInputBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "input:text" },
                "min_length": {
                  "maximum": 4096
                },
                "max_length": {
                  "maximum": 4096
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/lengthInputBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "input:textarea" },
                "min_length": { "maximum": 16000 },
                "max_length": { "maximum": 16000 }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/lengthInputBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "input:password" },
                "stored_input": {
                  "$ref": "#/$defs/identifier"
                },
                "min_length": { "maximum": 1024 },
                "max_length": { "maximum": 1024 }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/lengthInputBase" },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "input:phone" },
                "min_length": { "maximum": 64 },
                "max_length": { "maximum": 64 }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/inputBase" },
            {
              "type": "object",
              "required": ["options"],
              "properties": {
                "kind": { "enum": ["input:select", "input:choice"] },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 32,
                  "items": { "$ref": "#/$defs/option" }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/inputBase" },
            {
              "type": "object",
              "required": ["options", "min_selections", "max_selections"],
              "properties": {
                "kind": { "const": "input:choices" },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 32,
                  "items": { "$ref": "#/$defs/option" }
                },
                "min_selections": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "max_selections": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
