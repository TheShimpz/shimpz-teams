{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shimpz.com/assistant/v1/invocation.schema.json",
  "title": "Shimpz Power invocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "integrations"],
  "properties": {
    "input": {
      "type": "object"
    },
    "integrations": {
      "type": "object",
      "maxProperties": 4,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
