{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shimpz.com/assistant/v1/invocation.schema.json",
  "title": "Shimpz Action invocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "integrations", "stored_inputs", "operation_id"],
  "properties": {
    "input": {
      "type": "object"
    },
    "operation_id": {
      "$ref": "#/$defs/operationId"
    },
    "integrations": {
      "type": "object",
      "maxProperties": 4,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "stored_inputs": {
      "type": "object",
      "maxProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "responses": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/humanResponse"
      }
    }
  },
  "$defs": {
    "operationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "responseBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "fingerprint", "kind", "value"],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "kind": {},
        "value": {}
      }
    },
    "humanResponse": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/responseBase" },
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": {
                  "enum": [
                    "approval",
                    "auth:password",
                    "auth:totp",
                    "auth:passkey"
                  ]
                },
                "value": { "const": true }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/responseBase" },
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": {
                  "enum": ["input:text", "input:textarea"]
                },
                "value": {
                  "type": "string",
                  "maxLength": 16000
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/responseBase" },
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "input:password" },
                "value": {
                  "type": "string",
                  "maxLength": 1024
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/responseBase" },
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "input:phone" },
                "value": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/responseBase" },
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "enum": ["input:select", "input:choice"] },
                "value": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/responseBase" },
            {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "input:choices" },
                "value": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
