{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shimpz.com/assistant/v1/machine-contract.schema.json",
  "title": "Shimpz Assistant SDK machine contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "actions"],
  "properties": {
    "version": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "objectSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input_schema", "output_schema", "integrations", "human_requests"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "input_schema": {
          "$ref": "#/$defs/objectSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/objectSchema"
        },
        "integrations": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "human_requests": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/humanRequestCapability"
          }
        }
      }
    },
    "humanRequestCapability": {
      "enum": [
        "approval",
        "input:text",
        "input:textarea",
        "input:password",
        "input:phone",
        "input:select",
        "input:choice",
        "input:choices",
        "auth:reauth",
        "auth:second-factor",
        "auth:phishing-resistant"
      ]
    }
  }
}
