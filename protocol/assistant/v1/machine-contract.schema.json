{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shimpz.com/assistant/v1/machine-contract.schema.json",
  "title": "Shimpz Assistant SDK machine contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "actions", "messages"],
  "properties": {
    "version": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "objectSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input_schema", "output_schema", "integrations", "stored_inputs", "human_requests"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "input_schema": {
          "$ref": "#/$defs/objectSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/objectSchema"
        },
        "integrations": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "stored_inputs": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "human_requests": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/humanRequestCapability"
          },
          "contains": {
            "enum": ["approval", "auth:password", "auth:totp", "auth:passkey"]
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "msgid", "max_length", "params"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "msgid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "max_length": {
          "enum": [80, 120, 160, 500]
        },
        "params": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/messageParam"
          }
        }
      }
    },
    "messageParam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "max_length"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "kind": {
          "enum": ["integer", "domain", "dns_name", "identifier"]
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 253
        }
      }
    },
    "humanRequestCapability": {
      "enum": [
        "approval",
        "input:text",
        "input:textarea",
        "input:password",
        "input:phone",
        "input:select",
        "input:choice",
        "input:choices",
        "auth:password",
        "auth:totp",
        "auth:passkey"
      ]
    }
  }
}
