{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shimpz.com/assistant-install/v1/definitions.schema.json",
  "title": "Shimpz Assistant-install contract definitions v1",
  "$defs": {
    "accountIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,31}$"
    },
    "teamIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,40}$"
    },
    "assistantIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "not": {
        "enum": [
          "postgres",
          "assistant-egress",
          "shimpz-assistant-egress"
        ]
      }
    },
    "componentIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "imageReference": {
      "type": "string",
      "pattern": "^ghcr\\.io/theshimpz/shimpz-assistant@sha256:[0-9a-f]{64}$"
    },
    "trustReference": {
      "type": "string",
      "pattern": "^ghcr\\.io/theshimpz/shimpz-assistant-trust@sha256:[0-9a-f]{64}$"
    },
    "opaqueIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "unixTime": {
      "type": "integer",
      "minimum": 0
    },
    "teamListDelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "account_id",
        "action",
        "jti",
        "iat",
        "exp",
        "request_id",
        "idempotency_key"
      ],
      "properties": {
        "iss": {
          "const": "https://developers.shimpz.com"
        },
        "aud": {
          "const": "https://developers.shimpz.com/assistant-install"
        },
        "account_id": {
          "$ref": "#/$defs/accountIdentifier"
        },
        "action": {
          "const": "teams:list"
        },
        "jti": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "iat": {
          "$ref": "#/$defs/unixTime"
        },
        "exp": {
          "$ref": "#/$defs/unixTime"
        },
        "request_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaqueIdentifier"
        }
      }
    },
    "assistantInstallDelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "account_id",
        "action",
        "team_id",
        "source_digest",
        "jti",
        "iat",
        "exp",
        "request_id",
        "idempotency_key"
      ],
      "properties": {
        "iss": {
          "const": "https://developers.shimpz.com"
        },
        "aud": {
          "const": "https://developers.shimpz.com/assistant-install"
        },
        "account_id": {
          "$ref": "#/$defs/accountIdentifier"
        },
        "action": {
          "const": "assistant:install"
        },
        "team_id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "jti": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "iat": {
          "$ref": "#/$defs/unixTime"
        },
        "exp": {
          "$ref": "#/$defs/unixTime"
        },
        "request_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaqueIdentifier"
        }
      }
    },
    "delegationClaims": {
      "oneOf": [
        {
          "$ref": "#/$defs/teamListDelegation"
        },
        {
          "$ref": "#/$defs/assistantInstallDelegation"
        }
      ]
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "teamListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "teams"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/team"
          }
        }
      }
    },
    "objectSchema": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_schema",
        "output_schema",
        "integrations",
        "stored_inputs",
        "input_files",
        "human_requests",
        "effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentIdentifier"
        },
        "input_schema": {
          "$ref": "#/$defs/objectSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/objectSchema"
        },
        "integrations": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentIdentifier"
          }
        },
        "stored_inputs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentIdentifier"
          }
        },
        "input_files": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "human_requests": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "contains": {
            "enum": [
              "approval",
              "auth:password",
              "auth:totp",
              "auth:passkey"
            ]
          },
          "minContains": 0,
          "maxContains": 1,
          "items": {
            "enum": [
              "approval",
              "input:text",
              "input:textarea",
              "input:password",
              "input:phone",
              "input:select",
              "input:choice",
              "input:choices",
              "auth:password",
              "auth:totp",
              "auth:passkey"
            ]
          }
        },
        "effect": {
          "enum": [
            "read_only",
            "mutating"
          ]
        },
        "verifier": {
          "$ref": "#/$defs/verifier"
        },
        "idempotency": {
          "$ref": "#/$defs/idempotency"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "input",
        "outcome",
        "result"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/componentIdentifier"
        },
        "input": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/verifierBinding"
          }
        },
        "outcome": {
          "$ref": "#/$defs/jsonPointer"
        },
        "result": {
          "$ref": "#/$defs/jsonPointer"
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "key",
        "scope",
        "retention_seconds",
        "same_payload_required"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "location",
            "name"
          ],
          "properties": {
            "location": {
              "enum": [
                "header",
                "query",
                "body"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          }
        },
        "scope": {
          "enum": [
            "account",
            "endpoint"
          ]
        },
        "retention_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 31536000
        },
        "same_payload_required": {
          "enum": [
            true,
            false
          ]
        }
      }
    },
    "verifierBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "const": "operation_id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "pointer"
          ],
          "properties": {
            "from": {
              "const": "input"
            },
            "pointer": {
              "$ref": "#/$defs/jsonPointer"
            }
          }
        }
      ]
    },
    "jsonPointer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^(?:/(?:[^/~]|~[01])+)+$"
    },
    "machineContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "actions",
        "messages"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/message"
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "msgid",
        "max_length",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "msgid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "max_length": {
          "enum": [
            80,
            120,
            160,
            500
          ]
        },
        "params": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/messageParam"
          }
        }
      }
    },
    "messageParam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "max_length"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "kind": {
          "enum": [
            "integer",
            "domain",
            "dns_name",
            "identifier"
          ]
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 253
        }
      }
    },
    "runtimeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "integer"
        }
      }
    },
    "directRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "db",
        "user",
        "interpreter",
        "entrypoint",
        "action_executable",
        "manifest",
        "machine_contract",
        "language_pack",
        "read_only_root",
        "tmpfs_bytes",
        "capabilities",
        "no_new_privileges"
      ],
      "properties": {
        "kind": {
          "const": "assistant-direct-v1"
        },
        "db": {
          "const": false
        },
        "user": {
          "const": "10001:10001"
        },
        "interpreter": {
          "const": "/opt/shimpz/runtime/bin/python3.14"
        },
        "entrypoint": {
          "type": "array",
          "prefixItems": [
            {
              "const": "/opt/shimpz/runtime/bin/python3.14"
            },
            {
              "const": "-c"
            },
            {
              "const": "import signal; signal.pause()"
            }
          ],
          "items": false
        },
        "action_executable": {
          "allOf": [
            {
              "$ref": "#/$defs/runtimeFile"
            },
            {
              "properties": {
                "path": {
                  "const": "/usr/local/bin/shimpz-action"
                },
                "mode": {
                  "const": 365
                }
              }
            }
          ]
        },
        "manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/runtimeFile"
            },
            {
              "properties": {
                "path": {
                  "const": "/opt/shimpz/shimpz.toml"
                },
                "mode": {
                  "const": 292
                }
              }
            }
          ]
        },
        "machine_contract": {
          "allOf": [
            {
              "$ref": "#/$defs/runtimeFile"
            },
            {
              "properties": {
                "path": {
                  "const": "/opt/shimpz/shimpz.contract.json"
                },
                "mode": {
                  "const": 292
                }
              }
            }
          ]
        },
        "language_pack": {
          "allOf": [
            {
              "$ref": "#/$defs/runtimeFile"
            },
            {
              "properties": {
                "path": {
                  "const": "/opt/shimpz/shimpz.pack.json"
                },
                "mode": {
                  "const": 292
                }
              }
            }
          ]
        },
        "read_only_root": {
          "const": true
        },
        "tmpfs_bytes": {
          "const": 67108864
        },
        "capabilities": {
          "type": "array",
          "maxItems": 0
        },
        "no_new_privileges": {
          "const": true
        }
      }
    },
    "integrationIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "scopes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentIdentifier"
        },
        "provider": {
          "$ref": "#/$defs/componentIdentifier"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9.:/_-]*$"
          }
        }
      }
    },
    "storedInputIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentIdentifier"
        },
        "kind": {
          "const": "password"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "help_url": {
          "$ref": "#/$defs/helpUrl"
        }
      }
    },
    "helpUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://(?=[^/]{1,253}/)(?![^/]*\\.(?:arpa|example|home|internal|invalid|lan|local|localdomain|localhost|onion|test)/)(?:(?!xn--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+(?!xn--)[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?:/(?!\\.\\.?(?:/|\\?|(?![\\s\\S])))(?:[A-Za-z0-9._~!$&()*+,;=:@-]|%(?!2E)[0-9A-F]{2})*)+(?:\\?(?:[A-Za-z0-9._~!$&()*+,;=:@/?-]|%[0-9A-F]{2})+)?(?![\\s\\S])"
    },
    "artifactTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_reference",
        "provenance_reference",
        "signer_identity"
      ],
      "properties": {
        "signature_reference": {
          "$ref": "#/$defs/trustReference"
        },
        "provenance_reference": {
          "$ref": "#/$defs/trustReference"
        },
        "signer_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "resolveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "assistant_id",
        "name",
        "summary",
        "assistant_version",
        "creators",
        "source_digest",
        "icon_digest",
        "image_reference",
        "oci_digest",
        "platforms",
        "runtime",
        "manifest_digest",
        "machine_contract_digest",
        "machine_contract",
        "pack_digest",
        "allowed_hosts",
        "integrations",
        "stored_inputs",
        "review_state",
        "blocked",
        "sbom_digest",
        "scan_digest",
        "trust"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "assistant_id": {
          "$ref": "#/$defs/assistantIdentifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff]+$"
        },
        "assistant_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          }
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "icon_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "image_reference": {
          "$ref": "#/$defs/imageReference"
        },
        "oci_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "platforms": {
          "type": "array",
          "prefixItems": [
            {
              "const": "linux/amd64"
            },
            {
              "const": "linux/arm64"
            }
          ],
          "items": false
        },
        "runtime": {
          "$ref": "#/$defs/directRuntime"
        },
        "manifest_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "machine_contract_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "machine_contract": {
          "$ref": "#/$defs/machineContract"
        },
        "pack_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "allowed_hosts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "integrations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/integrationIntent"
          }
        },
        "stored_inputs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/storedInputIntent"
          }
        },
        "review_state": {
          "enum": [
            "pending",
            "approved",
            "catalog_rejected"
          ]
        },
        "blocked": {
          "const": false
        },
        "sbom_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "scan_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "trust": {
          "$ref": "#/$defs/artifactTrust"
        }
      }
    },
    "installRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "team_id",
        "source_digest",
        "request_id",
        "idempotency_key"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "team_id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "request_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/opaqueIdentifier"
        }
      }
    },
    "installResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "team_id",
        "assistant_id",
        "source_digest",
        "oci_digest",
        "binding_digest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "status": {
          "const": "installed"
        },
        "team_id": {
          "$ref": "#/$defs/teamIdentifier"
        },
        "assistant_id": {
